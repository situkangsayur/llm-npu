[Unit]
Description=Open WebUI (chat GUI) untuk FLM — http://localhost:3000
Requires=docker.service
After=docker.service flm.service
# Ikut berhenti saat flm-stack.target di-stop.
PartOf=flm-stack.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/hendri/my-projects/llms
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
