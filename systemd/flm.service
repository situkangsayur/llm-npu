[Unit]
Description=FastFlowLM (FLM) — NPU LLM API server (qwen3.5:2b)
Documentation=https://github.com/FastFlowLM/FastFlowLM
After=network-online.target
Wants=network-online.target
# Ikut berhenti saat flm-stack.target di-stop.
PartOf=flm-stack.target

[Service]
Type=simple
User=hendri
Group=hendri
Environment=HOME=/home/hendri
# FLM butuh memlock unlimited; service-level limit -> tidak bergantung re-login.
LimitMEMLOCK=infinity
# FLM jalan di localhost:52624, DI BELAKANG flm-filter.service (proxy allowlist
# di :52625). Proxy mencegah auto-download model yang tak diizinkan. FLM sendiri
# cukup bind 127.0.0.1 (hanya proxy yang menghubunginya) -> lebih aman.
# Model startup = default yang termuat. (Gemma 4 sengaja "dimatikan" — tak ada
# di allowlist proxy, jadi tak bisa dipilih; modelnya tetap ada di disk.)
ExecStart=/usr/bin/flm serve qwen3.5:2b --host 127.0.0.1 --port 52624
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
