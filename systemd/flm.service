[Unit]
Description=FastFlowLM (FLM) — NPU LLM API server (qwen3.5:2b)
Documentation=https://github.com/FastFlowLM/FastFlowLM
After=network-online.target
Wants=network-online.target
# Ikut berhenti saat flm-stack.target di-stop.
PartOf=flm-stack.target

[Service]
Type=simple
User=hendri
Group=hendri
Environment=HOME=/home/hendri
# FLM butuh memlock unlimited; service-level limit -> tidak bergantung re-login.
LimitMEMLOCK=infinity
# Port 52625 = default bawaan FLM (lihat `flm port`).
# --host 0.0.0.0 WAJIB: default FLM bind ke 127.0.0.1 saja, sehingga container
# Open WebUI (datang lewat IP gateway docker, mis. 172.17.0.1) tidak bisa
# menghubunginya -> "model tidak ditemukan". Bind ke 0.0.0.0 agar terjangkau.
ExecStart=/usr/bin/flm serve qwen3.5:2b --host 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
